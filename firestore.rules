rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidEmail(email) {
      return email is string
        && email.size() >= 3
        && email.size() <= 160
        && email == email.lower()
        && email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    function isHospitalEmail(email) {
      return isValidEmail(email)
        && email.matches('^[^\\s@]+@hospitals\\.gov\\.bh$');
    }

    function isAllowedWardEmail(email) {
      return isHospitalEmail(email) || email == 'ghsmc208@gmail.com';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function callerEmail() {
      return request.auth.token.email.lower();
    }

    function isVerifiedUser() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function isHospitalPasswordUser() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.firebase.sign_in_provider == 'password'
        && isHospitalEmail(callerEmail());
    }

    function isEligibleUser() {
      return (isVerifiedUser() && isAllowedWardEmail(callerEmail()))
        || isHospitalPasswordUser();
    }

    function emailToAccessId(email) {
      return email.lower().replace('[^a-z0-9_\\-]', '_');
    }

    function callerAccessId() {
      return emailToAccessId(callerEmail());
    }

    function isBootstrappedAdmin() {
      return (isVerifiedUser() && callerEmail() == 'ghsmc208@gmail.com')
        || (isHospitalPasswordUser() && callerEmail() == 'admin@hospitals.gov.bh')
        || (isVerifiedUser() && callerEmail() == 'admin@hospitals.gov.bh');
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isEligibleUser()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Validation Blueprints ---
    function isValidAdminRecord(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && isAllowedWardEmail(data.email)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.createdAt is timestamp;
    }

    function isValidWardUser(data, accessId) {
      return data.keys().hasAll([
          'id',
          'email',
          'displayName',
          'role',
          'status',
          'taskPermissions',
          'taskScopeMode',
          'allowedTaskIds',
          'inventoryPermissions',
          'canExportBackup',
          'canAddCustomInventory',
          'uid',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'email',
          'displayName',
          'role',
          'status',
          'taskPermissions',
          'taskScopeMode',
          'allowedTaskIds',
          'inventoryPermissions',
          'canExportBackup',
          'canAddCustomInventory',
          'uid',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == accessId
        && isAllowedWardEmail(data.email)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.role in ['admin', 'staff']
        && data.status in ['active', 'suspended']
        && data.taskPermissions is map
        && data.taskPermissions.keys().size() <= 20
        && data.taskScopeMode in ['all', 'selected']
        && data.allowedTaskIds is list
        && data.allowedTaskIds.size() <= 60
        && (data.allowedTaskIds.size() == 0 || data.allowedTaskIds[0] is string)
        && data.inventoryPermissions is map
        && data.inventoryPermissions.keys().size() <= 40
        && data.canExportBackup is bool
        && data.canAddCustomInventory is bool
        && data.uid is string
        && data.uid.size() <= 128
        && isValidId(data.createdByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWardModule(data, moduleId) {
      return data.keys().hasAll(['moduleId', 'payload', 'updatedAt', 'updatedByUid', 'updatedByEmail'])
        && data.keys().hasOnly(['moduleId', 'payload', 'updatedAt', 'updatedByUid', 'updatedByEmail'])
        && isValidId(data.moduleId)
        && data.moduleId == moduleId
        && data.moduleId.size() <= 64
        && data.payload is map
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && isValidId(data.updatedByUid)
        && data.updatedByUid == request.auth.uid
        && isAllowedWardEmail(data.updatedByEmail)
        && data.updatedByEmail == callerEmail();
    }

    function hasDesignatedAdminProfile() {
      let accessDocPath = /databases/$(database)/documents/wardUsers/$(callerAccessId());
      return isEligibleUser()
        && exists(accessDocPath)
        && get(accessDocPath).data.email == callerEmail()
        && (get(accessDocPath).data.uid == '' || get(accessDocPath).data.uid == request.auth.uid)
        && get(accessDocPath).data.role == 'admin'
        && get(accessDocPath).data.status == 'active';
    }

    function hasWardModuleReadAccess(moduleId) {
      let accessDocPath = /databases/$(database)/documents/wardUsers/$(callerAccessId());
      let userData = get(accessDocPath).data;
      return isEligibleUser()
        && exists(accessDocPath)
        && userData.email == callerEmail()
        && (userData.uid == '' || userData.uid == request.auth.uid)
        && userData.status == 'active'
        && (
          userData.role == 'admin'
          || moduleId == 'core'
          || (moduleId in userData.taskPermissions && userData.taskPermissions[moduleId] in ['view', 'edit', 'full'])
          || (
            moduleId.matches('^inv_[a-zA-Z0-9_\\-]+$')
            && moduleId.replace('^inv_', '') in userData.inventoryPermissions
            && userData.inventoryPermissions[moduleId.replace('^inv_', '')] in ['view', 'edit', 'full']
          )
        );
    }

    function hasWardModuleWriteAccess(moduleId) {
      let accessDocPath = /databases/$(database)/documents/wardUsers/$(callerAccessId());
      let userData = get(accessDocPath).data;
      return isEligibleUser()
        && exists(accessDocPath)
        && userData.email == callerEmail()
        && (userData.uid == '' || userData.uid == request.auth.uid)
        && userData.status == 'active'
        && (
          userData.role == 'admin'
          || (moduleId == 'core' && userData.canAddCustomInventory == true)
          || (moduleId in userData.taskPermissions && userData.taskPermissions[moduleId] in ['edit', 'full'])
          || (
            moduleId.matches('^inv_[a-zA-Z0-9_\\-]+$')
            && moduleId.replace('^inv_', '') in userData.inventoryPermissions
            && userData.inventoryPermissions[moduleId.replace('^inv_', '')] in ['edit', 'full']
          )
        );
    }

    // --- Collection Rules ---
    match /test/connection {
      allow get: if isSignedIn();
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isAdmin() || (isEligibleUser() && request.auth.uid == userId));
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isEligibleUser()
        && isValidAdminRecord(incoming(), userId)
        && incoming().createdAt == request.time
        && (
          isAdmin()
          || (request.auth.uid == userId && incoming().email == callerEmail() && hasDesignatedAdminProfile())
        );
      allow update: if isValidId(userId)
        && isAdmin()
        && isValidAdminRecord(incoming(), userId)
        && incoming().createdAt == existing().createdAt
        && incoming().uid == existing().uid;
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /wardUsers/{accessId} {
      allow get: if isValidId(accessId) && (
        isAdmin()
        || (
          isEligibleUser()
          && (
            accessId == callerAccessId()
            || (resource != null && existing().email == callerEmail())
          )
        )
      );
      allow list: if isAdmin() || (isEligibleUser() && existing().email == callerEmail());
      allow create: if isValidId(accessId)
        && isAdmin()
        && isValidWardUser(incoming(), accessId)
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(accessId)
        && isEligibleUser()
        && isValidWardUser(incoming(), accessId)
        && incoming().id == existing().id
        && incoming().email == existing().email
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().email == callerEmail()
            && existing().uid == ''
            && incoming().uid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['uid', 'updatedAt'])
          )
        );
      allow delete: if isValidId(accessId)
        && isAdmin()
        && existing().email != 'admin@hospitals.gov.bh'
        && existing().email != 'ghsmc208@gmail.com';
    }

    match /wardModules/{moduleId} {
      allow get: if isValidId(moduleId) && (isAdmin() || hasWardModuleReadAccess(moduleId));
      allow list: if isAdmin();
      allow create: if isValidId(moduleId)
        && isEligibleUser()
        && isValidWardModule(incoming(), moduleId)
        && (isAdmin() || hasWardModuleWriteAccess(moduleId));
      allow update: if isValidId(moduleId)
        && isEligibleUser()
        && isValidWardModule(incoming(), moduleId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['moduleId', 'payload', 'updatedAt', 'updatedByUid', 'updatedByEmail'])
        && (isAdmin() || hasWardModuleWriteAccess(moduleId));
      allow delete: if isValidId(moduleId) && isAdmin();
    }
  }
}
